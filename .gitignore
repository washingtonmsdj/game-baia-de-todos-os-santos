# Blender local files
*.blend1
*.blend2
*.blend@
*.autosave

# Large working scene files are not committed by default.
# Project revisions under blender/ are versioned with Git LFS; keep all other
# working .blend files outside Git by default.
*.blend
!blender/
!blender/*.blend

# Python
__pycache__/
*.py[cod]

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local generated reports
artifacts/
output/

# Acervo geográfico e visual pesado fica fora do Git.
# O Git versiona manifests, hashes, proveniência e catálogos em world/.
world-reference/
reference-media/
captures/
