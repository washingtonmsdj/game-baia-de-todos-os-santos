# Blender local files
*.blend1
*.blend2
*.blend@
*.autosave

# Large working scene files are not committed by default.
# Project revisions under blender/ are versioned with Git LFS; keep all other
# working .blend files outside Git by default.
*.blend
!blender/
!blender/*.blend
!blender/**/
!blender/**/*.blend

# Pacotes de engine reproduzíveis; fontes e contrato ficam no Git/LFS.
prototypes/threejs-water-lab/public/world/releases/
prototypes/threejs-water-lab/public/world/runtime.json
prototypes/threejs-water-lab/public/data/official_surfaces.json
prototypes/threejs-water-lab/public/assets/city/salvador_lacerda_mvp_r30a11_full.json

# Python
__pycache__/
*.py[cod]

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local generated reports
artifacts/
output/

# Acervo geográfico e visual pesado fica fora do Git.
# O Git versiona manifests, hashes, proveniência e catálogos em world/.
world-reference/
reference-media/
captures/

# Diagnósticos locais não reproduzíveis: dependem de caminhos/estado de uma máquina.
prototypes/threejs-water-lab/scripts/inspect-visual.cjs
automation/blender/r30a13_extract_route_anchors.py
docs/reports/blender/r30a13/
